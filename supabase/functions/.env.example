# Secrets des Edge Functions (à définir via `supabase secrets set`, jamais
# committés). Ce fichier documente les clés attendues, il ne contient
# aucune valeur réelle.

# Fournis automatiquement par Supabase en production, à définir localement
# pour `supabase functions serve` :
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Origine autorisée pour les appels CORS depuis le frontend Netlify.
FRONTEND_ORIGIN=https://votre-app.netlify.app

# Secret partagé pour authentifier les appels planifiés (cron) vers
# process-reminders et send-notification-worker (aucun JWT utilisateur
# n'existe pour ces invocations).
CRON_SECRET=

# SMS (fournisseur non encore choisi) : tant que ces variables sont
# absentes, le canal SMS reste inerte (aucun appel réseau).
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# WhatsApp Business Platform (Meta Cloud API) : tant que ces variables sont
# absentes, le canal WhatsApp reste inerte (aucun appel réseau).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
